{
  "schemaVersion": 1,
  "id": "guimaker",
  "version": "${version}",
  "name": "GUI Maker",
  "description": "Persistent GUI builder with native dialog menus, item click bindings, gated command presets and allowlisted actions.",
  "authors": ["Legends11", "runtoolkit"],
  "contact": {
    "sources": "https://github.com/runtoolkit/guimaker-fabric"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.runtoolkit.guimaker.GuiMakerMod"
    ],
    "client": [
      "com.runtoolkit.guimaker.GuiMakerClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.8",
    "java": ">=21"
  }
}
